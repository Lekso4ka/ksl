section#results.profit
    h4.label-btn.label-btn_light Профит
    //svg(viewBox="0 0 1440 1" fill="none" xmlns="http://www.w3.org/2000/svg")
    //    line.pr_line(x1="0" x2="0" y1="0" y2="1" stroke="red")
    h2.primary-caption.primary-caption_light.primary-caption_center
        span.primary-caption_iris Результаты клиентов
        |&#32;
        span.primary-caption_iris_760 — сокращение
        |&#32;затрат и рост эффективности
