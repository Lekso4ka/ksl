                    li Вместо одного центрального РЦ открыли 5 РЦ в регионах
                    li Сократили плечи доставки на 35%, ускорив поставки в ключевые города
                    li Ускорили масштабирование сети, сократив издержки на складскую логистику на 18%
                a.bottom(href="")
                    include ./vectors/arrow
                    span подробнее
        div.profit-item
            header
                h3 Прогресс
                .profit_h_img
                    img(src="./images/profit4.png" alt="")
                p производитель продуктов питания
            div.content
                h4 результат
                p Вместо проекта на 1,2 млрд запустили 9 эффективных складов в регионах
                .widgets
                    img(src="./images/widget_7.png" alt="")
                    img(src="./images/widget_8.png" alt="")
                h4 что сделали
                ul
                    li Снизили ежегодные операционные затраты
                    li Сократили долю упущенных продаж, разместив запасы ближе к потребителям
                    li Вышли в регионы за 3,5 месяца и обеспечили рост на 7 лет без строительства — за счёт сети арендуемых и 3PL-складов
                a.bottom(href="")
                    include ./vectors/arrow
                    span подробнее
        div.profit-item
            header
                h3 NDA*
                .profit_h_img
                    img(src="./images/profit5.png" alt="")
                p Крупнейший производитель строительных материалов
            div.content
                h4 результат
                p Сэкономили 42% логистических затрат и отказались от избыточного склада
                .widgets
                    img(src="./images/widget_9.png" alt="")
                    img(src="./images/widget_10.png" alt="")
                h4 что сделали
                ul
                    li Сократили арендные издержки, перейдя на другой формат складов
                    li Снизили площадь хранения от 2,1 до 5,6 раз по двум товарным группам
                    li Исключили перемещения без создания ценности: до 30% продукции в регионы отправлялось через центральный склад
                a.bottom(href="")
                    include ./vectors/arrow
                    span подробнее
script.
    const pCards = gsap.utils.toArray(".profit-item")
    const pCnt = document.querySelector(".p-cnt")
    const ptl = gsap.timeline({ paused: true });
    ptl
        .to(pCards[0], {
            transform: "translate(0, 100%)",
            duration: 1
        })
        .to(pCards[0], {
            opacity: 0,
            duration: .5
        }, "-=.5")
        .to(pCards[1], {
            transform: "translate(0, 0) scale(100%)",
            opacity: 1,
            duration: 1
        }, "-=1")
        .to(pCards[2], {
            transform: "translate(0, -.8rem) scale(94%)",
            opacity: .8,
            duration: 1
        }, "-=1")
        .to(pCards[3], {
            transform: "translate(0, -1.6rem) scale(88%)",
            opacity: .6,
            duration: 1
        }, "-=1")
        .to(pCards[4], {
            transform: "translate(0, -2.4rem) scale(82%)",
            opacity: .4,
            duration: 1
        }, "-=1")
        .to(pCards[1], {
            transform: "translate(0, 100%)",
            duration: 1
        })
        .to(pCards[1], {
            opacity: 0,
            duration: .5
        }, "-=.5")
        .to(pCards[2], {
            transform: "translate(0, 0) scale(100%)",
            opacity: 1,
            duration: 1
        }, "-=1")
        .to(pCards[3], {
            transform: "translate(0, -.8rem) scale(94%)",
            opacity: .8,
            duration: 1
        }, "-=1")
        .to(pCards[4], {
            transform: "translate(0, -1.6rem) scale(88%)",
            opacity: .6,
            duration: 1
        }, "-=1")
        .to(pCards[2], {
            transform: "translate(0, 100%)",
            duration: 1
        })
        .to(pCards[2], {
            opacity: 0,
            duration: .5
        }, "-=.5")
        .to(pCards[3], {
            transform: "translate(0, 0) scale(100%)",
            opacity: 1,
            duration: 1
        }, "-=1")
        .to(pCards[4], {
            transform: "translate(0, -.8rem) scale(94%)",
            opacity: .8,
            duration: 1
        }, "-=1")
        .to(pCards[3], {
            transform: "translate(0, 100%)",
            duration: 1
        })
        .to(pCards[3], {
            opacity: 0,
            duration: .5
        }, "-=.5")
        .to(pCards[4], {
            transform: "translate(0, 0) scale(100%)",
            opacity: 1,
            duration: 1
        }, "-=1")

    ScrollTrigger.create({
        trigger: ".profit",
        start: "bottom bottom",
        end: "+=3000",
        scrub: true,
        pin: true,
        onUpdate: (self) => {
            const progressCnt = 100 / (pCards.length);
            const current = Math.floor(self.progress * 100 / progressCnt)
            if (current <= pCards.length) {
                pCnt.innerText = `0${ current + 1 }`
            }
            ptl.progress(self.progress)
        }
    });
