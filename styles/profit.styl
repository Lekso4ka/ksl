.profit
    background-image url("./images/banner2.jpg")
    background-size cover
    background-position bottom center
    padding 10rem 1rem 2rem
    @media screen and (min-width: 1440px)
        padding 12rem 2rem 3rem
        .primary-caption
            width 53.8rem
            margin-left auto
            margin-right auto
            margin-bottom 1rem
    h2
        color #E5E5E5
        margin 1rem 0 2rem
    .figures
        margin 0 1rem
        opacity .2
    .cnt
        transform translate(0, -100%)
        //padding 0 1rem
        display flex
        align-items center
        justify-content space-between
        color white
    .sq_line
        width 100%
        margin 0 0 4rem
.profit-cards
    height 69.5rem
    position relative
    @media screen and (min-width: 760px)
        height 57.7rem
    @media screen and (min-width: 1440px)
        height 53.1rem
.profit-item
    position absolute
    bottom 0
    height 63rem
    background-color lGray
    border-radius 2rem
    padding 1rem 1rem 2rem
    box-sizing border-box
    margin-top 3.1rem
    transform-origin top center
    width 100%
    @media screen and (min-width: 760px)
        height 50rem
        display grid
        grid-template-columns repeat(2, 1fr)
        gap 2rem
        padding 2rem
    &:nth-child(1)
        z-index 5
    &:nth-child(2)
        z-index 4
        opacity .8
        transform translate(0, -.8rem) scale(94%)
    &:nth-child(3)
        z-index 3
        opacity .6
        transform translate(0, -1.6rem) scale(88%)
    &:nth-child(4)
        z-index 2
        opacity .4
        transform translate(0, -2.4rem) scale(82%)
    &:nth-child(5)
        z-index 1
        opacity .2
        transform translate(0, -3.2rem) scale(74%)
    header
        display grid
        grid-template-columns 18rem 1fr
        align-content space-between
        height 19.9rem
        box-sizing border-box
        background-repeat no-repeat
        background-color white
        border-radius 1.6rem
        overflow hidden
        h3
            padding 1rem 0 0 1rem
            font-size 1.8rem
            text-transform uppercase
        p
            font-size 1.2rem
            color inkDark60
            padding 0 0 1rem 1rem
            align-self flex-end
        .profit_h_img
            //height 100%
            grid-row-end span 2
            object-fit contain
            overflow hidden
            img
                width 118%
        @media screen and (min-width: 760px)
            grid-template-columns 15.1rem 1fr
            height 100%
            h3
                padding 2rem 0 0 2rem
            .profit_h_img
                grid-column-start 2
                grid-row-end 2
                img
                    width 165%
            p
                grid-column-end span 2
                width 19.9rem
                padding 0 0 2rem 2rem

            font-size 1.6rem
        @media screen and (min-width: 1440px)
            width 50.3rem
            grid-template-columns 1fr 31.8rem
            grid-template-rows 1fr auto
            h3
                padding 3rem 0 0 3rem
            .profit_h_img
                img
                    width 100%
            p
                padding 0 0 3rem 3rem
    //&:nth-child(1) > header
    //    background-image url("./images/profit1.png")
    //&:nth-child(2) > header
    //    background-image url("./images/profit2.png")
    //&:nth-child(3) > header
    //    background-image url("./images/profit3.png")
    //&:nth-child(4) > header
    //    background-image url("./images/profit4.png")
    //&:nth-child(5) > header
    //    background-image url("./images/profit5.png")

    .content
        padding 2rem 1rem 0
        h4
            display none
            @media screen and (min-width: 1440px)
                display block
                color iris
                margin-bottom 1.5rem
        p
            font-size 1.8rem
            margin-bottom 2rem
            @media screen and (min-width: 1440px)
                font-size: 2.2rem;
                line-height 1
                margin-bottom 3.3rem
            //letter-spacing -.018rem
        .widgets
            display grid
            grid-template-columns repeat(2, 1fr)
            gap 1.5rem
            margin-bottom 3rem
            img
                width 100%
            @media screen and (min-width: 1440px)
                margin-bottom 3.3rem
                height 8.6rem
                width auto
                justify-content flex-start
                gap 2rem
                grid-template-columns repeat(2, auto)
                img
                    height 100%
                    width auto
        ul
            display grid
            gap 2rem
            font-size 1.4rem
            @media screen and (min-width: 1440px)
                grid-template-columns 1fr 1fr
                gap 3rem 2rem
        li
            padding-left 2.8rem
            position relative
            &::before
                content url("./images/check.svg")
                position absolute
                left 0
    .bottom
        font-size 1rem
        color white
        background-color white20
        backdrop-filter blur(10px)
        text-transform uppercase
        border-radius .6rem
        height 2rem
        width 9.8rem
        top 2rem
        right 2rem
        position absolute
        display flex
        align-items center
        justify-content center
        gap .2rem
        span
            transition-property opacity, transform
            transition-duration 300ms
        svg
            width 1.2rem
            height 1.2rem
            path
                fill white
        @media screen and (min-width: 760px)
            background-color transparent
            width auto
            height auto
            top auto
            right auto
            bottom 2rem
            gap 1rem
            color inkDark
            font-size 1.2
            &:hover
                span
                    transform translate(1rem, 0)
                    opacity .5
            svg
                width 1.6rem
                height 1.6rem
                path
                    fill #212223
